# Claritas LMS Environment Configuration
PORT=5000
NODE_ENV=development

# JWT Secret Keys
JWT_SECRET=claritas_production_secret_key_change_in_prod_2026_xyz
JWT_REFRESH_SECRET=claritas_production_refresh_secret_key_change_in_prod_2026_abc
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration
# Cloud PostgreSQL (Supabase / Neon / Render Postgres)
# Leave blank or omit to automatically use local SQLite (node:sqlite)
# DATABASE_URL=postgresql://username:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=15

# Cloud File Storage (Optional - falls back to local disk 'uploads/' if omitted)
# STORAGE_PROVIDER=auto # Options: auto, local, cloudinary, supabase

# Option A: Cloudinary
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Option B: Supabase Storage
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# SUPABASE_BUCKET_NAME=claritas-media

