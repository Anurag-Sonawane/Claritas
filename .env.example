# Claritas LMS Environment Configuration
PORT=5000
NODE_ENV=development

# JWT Secret Keys
JWT_SECRET=claritas_production_secret_key_change_in_prod_2026_xyz
JWT_REFRESH_SECRET=claritas_production_refresh_secret_key_change_in_prod_2026_abc
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration
DATABASE_URL=file:./server/claritas.sqlite

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=15
